<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Training Mission Grading Form</title>
<style>
  :root{
    --bg:#12151a;
    --panel:#1a1f27;
    --panel-2:#20262f;
    --line:#2b3340;
    --text:#e7ecf2;
    --muted:#8b96a5;
    --cyan:#4fd8c9;
    --cyan-dim:#2c5a54;
    --amber:#f2a93b;
    --red:#e0645a;
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --sans: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:var(--sans);
    -webkit-font-smoothing:antialiased;
  }
  .wrap{ max-width:880px; margin:0 auto; padding:0 18px 60px; }

  /* Landing Screen */
  .landing-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 32px 24px;
    max-width: 500px;
    margin: 80px auto 0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  /* ---- HUD header ---- */
  .hud{
    position:sticky; top:0; z-index:20;
    background:linear-gradient(180deg, var(--bg) 80%, transparent);
    padding:16px 0 10px;
  }
  .hud-inner{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:14px 18px;
    display:flex;
    align-items:center;
    gap:18px;
  }
  .hud-home-btn{
    border:1px solid var(--line);
    background:var(--panel-2);
    color:var(--text);
    font-family:var(--sans);
    font-size:13px;
    font-weight:600;
    padding:8px 14px;
    border-radius:7px;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:6px;
    transition:border-color .15s, background .15s, color .15s;
    white-space:nowrap;
  }
  .hud-home-btn:hover{ border-color:var(--cyan); color:var(--cyan); }
  
  .hud-title{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--muted);
  }
  .hud-title strong{
    display:block;
    font-family:var(--sans);
    font-size:17px;
    letter-spacing:0;
    text-transform:none;
    color:var(--text);
    margin-top:2px;
    font-weight:600;
  }
  .hud-score{
    margin-left:auto;
    text-align:right;
    font-family:var(--mono);
    white-space:nowrap;
  }
  .hud-score .num{
    font-size:34px;
    font-weight:700;
    color:var(--cyan);
    line-height:1;
  }
  .hud-score .max{ color:var(--muted); font-size:16px; }
  .hud-score .label{ font-size:10px; letter-spacing:.12em; color:var(--muted); text-transform:uppercase; }
  .gauge{
    height:6px; border-radius:4px; background:var(--panel-2);
    margin-top:10px; overflow:hidden; border:1px solid var(--line);
  }
  .gauge-fill{
    height:100%; width:0%;
    background:linear-gradient(90deg, var(--cyan-dim), var(--cyan));
    transition:width .25s ease;
  }

  /* ---- stopwatch ---- */
  .stopwatch{
    display:flex; align-items:center; justify-content:space-between;
    gap:16px; flex-wrap:wrap;
  }
  .sw-time{
    font-family:var(--mono);
    font-size:40px;
    font-weight:700;
    color:var(--cyan);
    letter-spacing:.02em;
    font-variant-numeric:tabular-nums;
  }
  .sw-controls{ display:flex; gap:8px; }
  .sw-btn{
    border:1px solid var(--line);
    background:var(--panel-2);
    color:var(--text);
    font-family:var(--sans);
    font-size:13px;
    font-weight:600;
    padding:10px 18px;
    border-radius:7px;
    cursor:pointer;
    transition:border-color .15s, background .15s, color .15s;
  }
  .sw-btn:hover{ border-color:var(--cyan); }
  .sw-btn.start{ background:var(--cyan); border-color:var(--cyan); color:#0b1210; }
  .sw-btn.stop{ background:var(--red); border-color:var(--red); color:#0b1210; }
  .sw-btn.clear:hover{ border-color:var(--red); color:var(--red); }
  .sw-saved{
    margin-top:14px; padding-top:14px; border-top:1px solid var(--line);
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;
  }
  .sw-saved label{ margin:0; }
  .sw-saved-time{
    font-family:var(--mono); font-size:22px; font-weight:700; color:var(--amber);
  }

  /* ---- session info ---- */
  .card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:18px;
    margin-top:16px;
    page-break-inside: avoid;
  }
  .section-label{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--cyan);
    margin-bottom:12px;
  }
  .grid-2{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .grid-4{ display:grid; grid-template-columns:repeat(auto-fit, minmax(140px,1fr)); gap:12px; }
  @media (max-width:640px){ .grid-4{ grid-template-columns:1fr 1fr; } .grid-2{ grid-template-columns:1fr; } }
  label{
    display:block; font-size:11px; color:var(--muted);
    margin-bottom:5px; letter-spacing:.02em;
  }
  input[type=text], input[type=date], textarea, select{
    width:100%;
    background:var(--panel-2);
    border:1px solid var(--line);
    border-radius:6px;
    color:var(--text);
    padding:9px 10px;
    font-family:var(--sans);
    font-size:14px;
  }
  select{ appearance:none; -webkit-appearance:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6'><path d='M0 0l5 6 5-6z' fill='%238b96a5'/></svg>");
    background-repeat:no-repeat; background-position:right 12px center; padding-right:28px;
  }
  input:focus, textarea:focus, button:focus-visible{
    outline:2px solid var(--cyan);
    outline-offset:1px;
  }
  textarea{ resize:vertical; min-height:60px; line-height:1.4; }
  .links{ font-size:12.5px; color:var(--muted); margin-top:14px; line-height:1.8; }
  .links a{ color:var(--cyan); text-decoration:none; margin-right:14px; }
  .links a:hover{ text-decoration:underline; }

  /* ---- category card ---- */
  .cat{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:18px;
    margin-top:14px;
    page-break-inside: avoid;
  }
  .cat-head{
    display:flex; justify-content:space-between; align-items:flex-start; gap:12px;
  }
  .cat-num{
    font-family:var(--mono); font-size:11px; color:var(--muted);
  }
  .cat-title{ font-size:16px; font-weight:600; margin:2px 0 8px; }
  .cat-desc{ font-size:13px; color:var(--muted); line-height:1.55; margin-bottom:14px; white-space: pre-wrap; }

  .scores{ display:flex; gap:8px; flex-wrap:wrap; }
  .score-btn{
    flex:1 1 auto;
    min-width:46px;
    height:46px;
    border-radius:8px;
    border:1px solid var(--line);
    background:var(--panel-2);
    color:var(--text);
    font-family:var(--mono);
    font-size:16px;
    font-weight:600;
    cursor:pointer;
    transition:background .15s, border-color .15s, color .15s, transform .1s;
  }
  .score-btn:hover{ border-color:var(--cyan); }
  .score-btn:active{ transform:scale(0.95); }
  .score-btn.selected{
    background:var(--cyan);
    border-color:var(--cyan);
    color:#0b1210;
  }
  .cat-tally{
    font-family:var(--mono); font-size:11px; color:var(--muted);
    margin-top:8px; text-align:right;
  }
  .cat-tally span{ color:var(--cyan); font-weight:700; }

  .footer-total{
    display:flex; justify-content:space-between; align-items:center;
    background:var(--panel-2); border:1px solid var(--line); border-radius:8px;
    padding:14px 18px; margin-top:16px;
    page-break-inside: avoid;
  }
  .footer-total .fnum{ font-family:var(--mono); font-size:22px; color:var(--cyan); font-weight:700; }

  .reset-row{ text-align:center; margin-top:18px; }
  .reset-btn{
    background:none; border:1px solid var(--line); color:var(--muted);
    font-size:12px; padding:8px 16px; border-radius:6px; cursor:pointer;
    font-family:var(--sans);
  }
  .reset-btn:hover{ border-color:var(--red); color:var(--red); }

  .action-row{
    display:flex; gap:12px; justify-content:center; flex-wrap:wrap;
    margin-top:16px;
  }
  .action-btn{
    font-family:var(--sans); font-size:14px; font-weight:600;
    padding:12px 26px; border-radius:8px; cursor:pointer;
    border:1px solid var(--line); transition:background .15s, border-color .15s, opacity .15s;
  }
  .action-btn.primary{ background:var(--cyan); border-color:var(--cyan); color:#0b1210; }
  .action-btn.primary:hover{ opacity:.9; }
  .action-btn.secondary{ background:var(--panel-2); color:var(--text); }
  .action-btn.secondary:hover{ border-color:var(--cyan); }
  .action-btn.docs{ background:#4285F4; border-color:#4285F4; color:#ffffff; }
  .action-btn.docs:hover{ opacity:.9; }
  .action-btn:disabled{ opacity:.5; cursor:wait; }

  .history-item{
    display:flex; justify-content:space-between; align-items:center;
    gap:12px; padding:10px 12px; border:1px solid var(--line);
    border-radius:8px; margin-top:8px; background:var(--panel-2);
    flex-wrap:wrap;
  }
  .history-meta{ font-size:13px; }
  .history-meta .h-title{ font-weight:600; }
  .history-meta .h-sub{ color:var(--muted); font-size:11px; font-family:var(--mono); margin-top:2px; }
  .history-link{
    font-family:var(--sans); font-size:12.5px; font-weight:600;
    color:var(--cyan); text-decoration:none; border:1px solid var(--cyan);
    padding:6px 12px; border-radius:6px; background:none; cursor:pointer;
  }
  .history-link:hover{ background:var(--cyan); color:#0b1210; }
  .history-edit{
    font-family:var(--sans); font-size:12.5px; font-weight:600;
    color:var(--amber); text-decoration:none; border:1px solid var(--amber);
    padding:6px 12px; border-radius:6px; background:none; cursor:pointer;
  }
  .history-edit:hover{ background:var(--amber); color:#0b1210; }
  .history-actions{ display:flex; gap:8px; align-items:center; }
  .history-delete{
    font-family:var(--sans); font-size:12.5px; font-weight:600;
    color:var(--muted); background:none; text-decoration:none;
    border:1px solid var(--line); padding:6px 12px; border-radius:6px;
    cursor:pointer;
  }
  .history-delete:hover{ border-color:var(--red); color:var(--red); }
  .history-empty{ font-size:13px; color:var(--muted); }
  .history-note{ font-size:11.5px; color:var(--muted); margin-top:12px; line-height:1.5; }

  /* Perfect light-mode PDF / Print CSS rules */
  @media print {
    body { background: #ffffff !important; color: #111111 !important; }
    .wrap { max-width: 100% !important; padding: 0 !important; }
    .no-print, .hud, .action-row, .reset-row, .links, .stopwatch, .scores, #landingView { display: none !important; }
    .card, .cat, .footer-total { 
      background: #ffffff !important; 
      border: 1px solid #d0d0d0 !important; 
      color: #111111 !important; 
      page-break-inside: avoid;
      box-shadow: none !important;
      margin-top: 10px !important;
      padding: 12px 16px !important;
    }
    .hud-inner { background: #ffffff !important; border: 1px solid #cccccc !important; }
    .hud-title, .section-label, .cat-title { color: #008080 !important; }
    .hud-title strong { color: #111111 !important; }
    .hud-score .num { color: #008080 !important; }
    .fnum { color: #008080 !important; }
    input[type=text], input[type=date], textarea, select { 
      background: #fdfdfd !important; 
      border: 1px solid #cccccc !important; 
      color: #111111 !important; 
      font-size: 13px !important;
    }
    textarea { min-height: 40px !important; }
    .cat-desc { color: #555555 !important; }
    .cat-tally span { color: #008080 !important; }
  }

  /* Auth Screen */
  #authView {
    display: block;
  }
  .auth-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 32px 24px;
    max-width: 480px;
    margin: 60px auto 0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }
  .auth-tabs {
    display: flex;
    border-bottom: 1px solid var(--line);
    margin-bottom: 20px;
  }
  .auth-tab {
    flex: 1;
    padding: 10px;
    text-align: center;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color .15s, border-color .15s;
  }
  .auth-tab.active {
    color: var(--cyan);
    border-color: var(--cyan);
    font-weight: 700;
  }
  .google-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    background: #ffffff;
    color: #1a1f27;
    border: 1px solid #d0d7de;
    padding: 10px 16px;
    border-radius: 8px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    margin-bottom: 18px;
    transition: background .15s, border-color .15s;
  }
  .google-btn:hover {
    background: #f4f6f8;
    border-color: #bbbfc4;
  }
  .auth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    color: var(--muted);
    font-size: 11px;
    font-family: var(--mono);
    margin: 16px 0;
  }
  .auth-divider::before, .auth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--line);
  }
  .auth-divider span {
    padding: 0 10px;
  }
  .login-method-toggle {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
  }
  .method-btn {
    flex: 1;
    padding: 8px;
    font-size: 11px;
    font-family: var(--mono);
    border: 1px solid var(--line);
    background: var(--panel-2);
    color: var(--muted);
    border-radius: 6px;
    cursor: pointer;
    transition: all .15s;
  }
  .method-btn.active {
    border-color: var(--cyan);
    color: var(--cyan);
    background: var(--cyan-dim);
    font-weight: 600;
  }
  .user-badge {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--cyan);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .logout-btn {
    background: none;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 5px;
    cursor: pointer;
    transition: border-color .15s, color .15s;
  }
  .logout-btn:hover {
    border-color: var(--red);
    color: var(--red);
  }
</style>
<!-- Optional Firebase SDKs for Cloud Auth -->
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
</head>
<body>
<div class="wrap" id="pdfRoot">

  <!-- Auth Screen -->
  <div id="authView" class="no-print">
    <div class="auth-card">
      <div class="hud-title" style="margin-bottom:4px;">Zoox // Evaluator Portal</div>
      <h2 style="margin:0 0 16px; font-weight:700; font-size:20px; color:var(--text);" id="authHeading">Sign In</h2>
      
      <!-- Optional Google Sign-In Button -->
      <button type="button" class="google-btn" onclick="handleGoogleSignIn()">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
        Sign in with Google
      </button>

      <div class="auth-divider"><span>OR WITH USERNAME</span></div>

      <!-- Auth Tabs -->
      <div class="auth-tabs">
        <button type="button" class="auth-tab active" id="tabSignIn" onclick="switchAuthTab('signin')">Sign In</button>
        <button type="button" class="auth-tab" id="tabSignUp" onclick="switchAuthTab('signup')">Sign Up</button>
      </div>

      <!-- Sign In Form -->
      <form id="signInForm" onsubmit="handleSignIn(event)">
        <div style="margin-bottom:12px;">
          <label>Username</label>
          <input type="text" id="signinUsername" required placeholder="Enter your username">
        </div>

        <div style="margin-bottom:8px;">
          <label>Authentication Mode</label>
          <div class="login-method-toggle">
            <button type="button" class="method-btn active" id="btnMethodPassword" onclick="setLoginMethod('password')">Use Password</button>
            <button type="button" class="method-btn" id="btnMethodPin" onclick="setLoginMethod('pin')">Use PIN</button>
          </div>
        </div>

        <div style="margin-bottom:16px;" id="signinPasswordGroup">
          <label>Password</label>
          <input type="password" id="signinPassword" placeholder="Enter password">
        </div>

        <div style="margin-bottom:16px; display:none;" id="signinPinGroup">
          <label>4-6 Digit PIN</label>
          <input type="password" id="signinPin" placeholder="Enter PIN" maxlength="6" pattern="[0-9]*" inputmode="numeric">
        </div>

        <div id="signinError" style="color:var(--red); font-size:12px; margin-bottom:12px; display:none;"></div>

        <button type="submit" class="action-btn primary" style="width:100%; font-size:15px;">Sign In</button>
      </form>

      <!-- Sign Up Form -->
      <form id="signUpForm" onsubmit="handleSignUp(event)" style="display:none;">
        <div class="grid-2" style="margin-bottom:12px;">
          <div>
            <label>First Name</label>
            <input type="text" id="signupFirstName" required placeholder="First Name">
          </div>
          <div>
            <label>Last Name</label>
            <input type="text" id="signupLastName" required placeholder="Last Name">
          </div>
        </div>
        <div style="margin-bottom:12px;">
          <label>Username</label>
          <input type="text" id="signupUsername" required placeholder="Choose username">
        </div>
        <div style="margin-bottom:12px;">
          <label>Email Address</label>
          <input type="email" id="signupEmail" required placeholder="name@domain.com">
        </div>
        <div style="margin-bottom:12px;">
          <label>Password</label>
          <input type="password" id="signupPassword" required placeholder="Create password">
        </div>
        <div style="margin-bottom:16px;">
          <label>PIN (4-6 Digits)</label>
          <input type="password" id="signupPin" required placeholder="Create backup PIN" maxlength="6" pattern="[0-9]*" inputmode="numeric">
        </div>

        <div id="signupError" style="color:var(--red); font-size:12px; margin-bottom:12px; display:none;"></div>

        <button type="submit" class="action-btn primary" style="width:100%; font-size:15px;">Create Account</button>
      </form>

      <!-- Optional Firebase Notice / Status -->
      <div style="margin-top:20px; font-size:11px; color:var(--muted); text-align:center;">
        <span id="firebaseStatusText">Auth Mode: Local Storage & Optional Firebase SSO</span>
      </div>
    </div>
  </div>


  <!-- Landing Screen -->
  <div id="landingView" class="no-print" style="display:none;">
    <div class="landing-card">
      <div class="hud-title" style="margin-bottom:6px;">Zoox // L3 Field Eval</div>
      <h2 style="margin:0 0 18px; font-weight:700; font-size:20px; color:var(--text);">Select Training</h2>
      <div style="margin-bottom:20px;">
        <label>Training Module</label>
        <select id="initialTrainingSelect" style="font-size:15px; padding:11px 12px;">
          <option value="" disabled selected>-- Select Training --</option>
          <option value="SWO">SWO</option>
          <option value="SVO">SVO</option>
          <option value="VO">VO</option>
          <option value="Manual Check-in">Manual Check-in</option>
          <option value="ZIP">ZIP</option>
          <option value="Highway">Highway</option>
        </select>
      </div>
      <button class="action-btn primary" style="width:100%; font-size:15px;" onclick="confirmStartTraining()">Start Evaluation</button>
    </div>
  </div>

  <!-- Main Evaluation View -->
  <div id="mainFormWrap" style="display:none;">

    <div class="hud">
      <div class="hud-inner">
        <button class="hud-home-btn no-print" onclick="goHome()" title="Return to Training Selection">
