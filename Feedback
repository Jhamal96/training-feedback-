function switchAuthTab(tab) {
  const tabSignIn = document.getElementById('tabSignIn');
  const tabSignUp = document.getElementById('tabSignUp');
  const signInForm = document.getElementById('signInForm');
  const signUpForm = document.getElementById('signUpForm');
  const heading = document.getElementById('authHeading');

  if (tab === 'signin') {
    tabSignIn.classList.add('active');
    tabSignUp.classList.remove('active');
    signInForm.style.display = 'block';
    signUpForm.style.display = 'none';
    heading.textContent = 'Sign In';
  } else {
    tabSignUp.classList.add('active');
    tabSignIn.classList.remove('active');
    signUpForm.style.display = 'block';
    signInForm.style.display = 'none';
    heading.textContent = 'Create Account';
  }
}

function setLoginMethod(method) {
  activeLoginMethod = method;
  const btnPass = document.getElementById('btnMethodPassword');
  const btnPin = document.getElementById('btnMethodPin');
  const passGroup = document.getElementById('signinPasswordGroup');
  const pinGroup = document.getElementById('signinPinGroup');

  if (method === 'password') {
    btnPass.classList.add('active');
    btnPin.classList.remove('active');
    passGroup.style.display = 'block';
    pinGroup.style.display = 'none';
    document.getElementById('signinPassword').required = true;
    document.getElementById('signinPin').required = false;
  } else {
    btnPin.classList.add('active');
    btnPass.classList.remove('active');
    pinGroup.style.display = 'block';
    passGroup.style.display = 'none';
    document.getElementById('signinPin').required = true;
    document.getElementById('signinPassword').required = false;
  }
}

function getRegisteredUsers() {
  try {
    const data = localStorage.getItem('zoox_registered_users');
    return data ? JSON.parse(data) : [];
  } catch(e) {
    return [];
  }
}

function saveRegisteredUsers(users) {
  localStorage.setItem('zoox_registered_users', JSON.stringify(users));
}

function setCurrentUser(user) {
  currentUser = user;
  sessionStorage.setItem('zoox_current_user', JSON.stringify(user));
  updateUserDisplay();
}

function updateUserDisplay() {
  const badge = document.getElementById('hudUserBadge');
  if (currentUser) {
    const fullName = `${currentUser.firstName || ''} ${currentUser.lastName || ''}`.trim() || currentUser.username;
    if (badge) {
      badge.style.display = 'flex';
      badge.innerHTML = `<span>Proctor: <strong>${fullName}</strong></span> <button type="button" class="logout-btn" onclick="handleLogout()">Log Out</button>`;
    }
    // Auto-populate Trainee or Evaluator name reference if empty
    const traineeField = document.getElementById('traineeNameField');
    if (traineeField && !traineeField.value) {
      // Keep trainee name empty for entering actual trainee, but store logged-in evaluator for exports
    }
  } else if (badge) {
    badge.style.display = 'none';
  }
}

function handleSignUp(e) {
  e.preventDefault();
  const firstName = document.getElementById('signupFirstName').value.trim();
  const lastName = document.getElementById('signupLastName').value.trim();
  const username = document.getElementById('signupUsername').value.trim().toLowerCase();
  const email = document.getElementById('signupEmail').value.trim().toLowerCase();
  const password = document.getElementById('signupPassword').value;
  const pin = document.getElementById('signupPin').value.trim();
  const errDiv = document.getElementById('signupError');

  errDiv.style.display = 'none';

  if (!firstName || !lastName || !username || !email || !password || !pin) {
    errDiv.textContent = 'Please fill in all required sign-up fields.';
    errDiv.style.display = 'block';
    return;
  }

  const users = getRegisteredUsers();
  if (users.some(u => u.username.toLowerCase() === username)) {
    errDiv.textContent = 'Username already exists. Please choose another username or sign in.';
    errDiv.style.display = 'block';
    return;
  }

  const newUser = { firstName, lastName, username, email, password, pin, id: Date.now() };
  users.push(newUser);
  saveRegisteredUsers(users);

  // Authenticate user
  setCurrentUser(newUser);
  proceedToApp();
}

function handleSignIn(e) {
  e.preventDefault();
  const username = document.getElementById('signinUsername').value.trim().toLowerCase();
  const password = document.getElementById('signinPassword').value;
  const pin = document.getElementById('signinPin').value.trim();
  const errDiv = document.getElementById('signinError');

  errDiv.style.display = 'none';

  const users = getRegisteredUsers();
  const foundUser = users.find(u => u.username.toLowerCase() === username);

  if (!foundUser) {
    errDiv.textContent = 'Username not found. Please check spelling or Sign Up first.';
    errDiv.style.display = 'block';
    return;
  }

  if (activeLoginMethod === 'password') {
    if (foundUser.password !== password) {
      errDiv.textContent = 'Incorrect password.';
      errDiv.style.display = 'block';
      return;
    }
  } else {
    if (foundUser.pin !== pin) {
      errDiv.textContent = 'Incorrect PIN.';
      errDiv.style.display = 'block';
      return;
    }
  }

  setCurrentUser(foundUser);
  proceedToApp();
}

function handleGoogleSignIn() {
  if (isFirebaseConfigured && typeof firebase !== 'undefined') {
    const provider = new firebase.auth.GoogleAuthProvider();
    firebase.auth().signInWithPopup(provider)
      .then((result) => {
        const u = result.user;
        const names = (u.displayName || 'Google User').split(' ');
        const gUser = {
          firstName: names[0] || 'Google',
          lastName: names.slice(1).join(' ') || 'User',
          username: u.email ? u.email.split('@')[0] : 'googleuser',
          email: u.email || '',
          id: u.uid
        };
        setCurrentUser(gUser);
        proceedToApp();
      })
      .catch((error) => {
        alert('Google Sign-In Error: ' + error.message);
      });
  } else {
    // Quick Local Google Sign-In Simulation
    const nameInput = prompt("Enter your Name or Google account name for evaluator login:", "Alain Dabady");
    if (nameInput && nameInput.trim()) {
      const parts = nameInput.trim().split(' ');
      const gUser = {
        firstName: parts[0] || 'Evaluator',
        lastName: parts.slice(1).join(' ') || '',
        username: (parts[0] || 'evaluator').toLowerCase(),
        email: 'evaluator@zoox.com',
        id: Date.now()
      };
      setCurrentUser(gUser);
      proceedToApp();
    }
  }
}

function handleLogout() {
  if (confirm("Log out of the Evaluator Portal?")) {
    sessionStorage.removeItem('zoox_current_user');
    currentUser = null;
    updateUserDisplay();
    document.getElementById('mainFormWrap').style.display = 'none';
    document.getElementById('landingView').style.display = 'none';
    document.getElementById('authView').style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
}

function proceedToApp() {
  document.getElementById('authView').style.display = 'none';
  document.getElementById('landingView').style.display = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function checkInitialAuth() {
  try {
    const storedUser = sessionStorage.getItem('zoox_current_user');
    if (storedUser) {
      currentUser = JSON.parse(storedUser);
      updateUserDisplay();
      document.getElementById('authView').style.display = 'none';
      document.getElementById('landingView').style.display = 'block';
    } else {
      document.getElementById('authView').style.display = 'block';
      document.getElementById('landingView').style.display = 'none';
    }
  } catch(e) {
    document.getElementById('authView').style.display = 'block';
    document.getElementById('landingView').style.display = 'none';
  }
}

// Check session auth on DOM ready
document.addEventListener('DOMContentLoaded', checkInitialAuth);

