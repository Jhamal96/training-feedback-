let activeCategories = swoCategories;
let scores = [];
const maxPerCategory = 5;
let currentEditingId = null;

function getCategoriesForType(type) {
  if (type === 'ZIP') {
    return zipCategories;
  } else if (type === 'Highway') {
    return highwayCategories;
  } else if (type === 'VO') {
    return voCategories;
  } else if (type === 'Manual Check-in') {
    return manualCheckInCategories;
  } else if (type === 'SVO') {
    return svoCategories;
  } else if (type === 'SWO') {
    return swoCategories;
  }
  return [];
}

function renderCategoryCards() {
  const catContainer = document.getElementById('categories');
  catContainer.innerHTML = '';
  scores = new Array(activeCategories.length).fill(null);

  if (activeCategories.length === 0) {
    const activeType = document.getElementById('activeTrainingType').value;
    catContainer.innerHTML = `
      <div class="card" style="text-align:center; padding:36px 20px; color:var(--muted); margin-top:14px;">
        <div style="font-family:var(--mono); font-size:12px; letter-spacing:.12em; color:var(--cyan); margin-bottom:6px; text-transform:uppercase;">${activeType} Module</div>
        <div style="font-size:15px; color:var(--text);">No evaluation categories defined for this training type yet.</div>
      </div>
    `;
  } else {
    activeCategories.forEach(([title, desc], i) => {
      const card = document.createElement('div');
      card.className = 'cat';
      card.innerHTML = `
        <div class="cat-head">
          <div>
            <div class="cat-num">CATEGORY ${String(i+1).padStart(2,'0')} / ${String(activeCategories.length).padStart(2,'0')}</div>
            <div class="cat-title" id="catTitle-${i}">${title}</div>
          </div>
        </div>
        <div class="cat-desc">${desc}</div>
        <div class="scores no-print" id="scores-${i}"></div>
        <div class="cat-tally" id="tally-${i}">Score: <span>0</span> / ${maxPerCategory}</div>
        <div style="margin-top:12px;" class="cat-notes-wrap">
          <label>Notes</label>
          <textarea id="catNotes-${i}" placeholder="Observations for this category..."></textarea>
        </div>
      `;
      catContainer.appendChild(card);

      const scoreRow = card.querySelector(`#scores-${i}`);
      for (let s = 0; s <= maxPerCategory; s++) {
        const btn = document.createElement('button');
        btn.className = 'score-btn';
        btn.textContent = s;
        btn.type = 'button';
        btn.addEventListener('click', () => {
          scores[i] = s;
          scoreRow.querySelectorAll('.score-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          card.querySelector(`#tally-${i} span`).textContent = s;
          updateTotal();
        });
        scoreRow.appendChild(btn);
      }
    });
  }

  const maxTotal = activeCategories.length * maxPerCategory;
  document.getElementById('maxScoreDisplay').textContent = ` / ${maxTotal}`;
  document.getElementById('maxScoreDisplay2').textContent = ` / ${maxTotal}`;
  
  if (savedSwTimeValue) {
    updateSetupTitle(savedSwTimeValue);
  }
  updateTotal();
}

function onTrainingTypeChange() {
  const type = document.getElementById('activeTrainingType').value;
  activeCategories = getCategoriesForType(type);
  document.getElementById('hudTrainingTitle').textContent = `${type} Training Mission Grading Form`;
  renderCategoryCards();
}

function confirmStartTraining() {
  const sel = document.getElementById('initialTrainingSelect').value;
  if (!sel) {
    alert("Please select a training module.");
    return;
  }
  document.getElementById('activeTrainingType').value = sel;
  document.getElementById('landingView').style.display = 'none';
  document.getElementById('mainFormWrap').style.display = 'block';
  onTrainingTypeChange();
}

function goHome() {
  document.getElementById('mainFormWrap').style.display = 'none';
  document.getElementById('landingView').style.display = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function updateTotal(){
  const total = scores.reduce((sum, v) => sum + (v || 0), 0);
  const max = activeCategories.length * maxPerCategory;
  document.getElementById('totalScore').textContent = total;
  document.getElementById('totalScore2').textContent = total;
  document.getElementById('gaugeFill').style.width = max > 0 ? (total / max * 100) + '%' : '0%';
}

function resetScores(){
  for (let i=0;i<scores.length;i++){
    scores[i] = null;
    const scoreRow = document.getElementById(`scores-${i}`);
    if (scoreRow) {
      scoreRow.querySelectorAll('.score-btn').forEach(b=>b.classList.remove('selected'));
    }
    const tallySpan = document.querySelector(`#tally-${i} span`);
    if (tallySpan) tallySpan.textContent = '0';
  }
  updateTotal();
}

function resetForm(){
  if(!confirm('Clear all selected scores?')) return;
  resetScores();
}

// ---- Stopwatch ----
let swSeconds = 0;
let swInterval = null;
let swRunning = false;
let savedSwTimeValue = "";
const swDisplay = document.getElementById('swDisplay');
const swStartBtn = document.getElementById('swStartBtn');

function swFormat(totalSeconds){
  const h = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
  const m = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
  const s = String(totalSeconds % 60).padStart(2, '0');
  return `${h}:${m}:${s}`;
}

function swToggle(){
  if (swRunning){
    clearInterval(swInterval);
    swRunning = false;
    swStartBtn.textContent = 'Start';
    swStartBtn.classList.remove('stop');
    swStartBtn.classList.add('start');
  } else {
    swInterval = setInterval(() => {
      swSeconds++;
      swDisplay.textContent = swFormat(swSeconds);
    }, 1000);
    swRunning = true;
    swStartBtn.textContent = 'Pause';
    swStartBtn.classList.remove('start');
    swStartBtn.classList.add('stop');
  }
}

function updateSetupTitle(timeStr) {
  const cat0Title = document.getElementById('catTitle-0');
  if (cat0Title) {
    if (timeStr) {
      cat0Title.textContent = `Setup / ${timeStr}`;
    } else {
      cat0Title.textContent = `Setup`;
    }
  }
}

function swClear(){
  clearInterval(swInterval);
  swRunning = false;
  swSeconds = 0;
  savedSwTimeValue = "";
  swDisplay.textContent = swFormat(0);
  swStartBtn.textContent = 'Start';
  swStartBtn.classList.remove('stop');
  swStartBtn.classList.add('start');
  document.getElementById('swSavedRow').style.display = 'none';
  document.getElementById('swSavedTime').textContent = "00:00:00";
  updateSetupTitle("");
}

function swSave(){
  if (swSeconds === 0) {
    const manualTime = prompt("Stopwatch was not started. Enter Setup Time (e.g., 00:12:30 or 15 mins):", savedSwTimeValue || "00:15:00");
    if (manualTime !== null && manualTime.trim() !== "") {
      savedSwTimeValue = manualTime.trim();
    } else {
      return;
    }
  } else {
    savedSwTimeValue = swFormat(swSeconds);
  }
  document.getElementById('swSavedTime').textContent = savedSwTimeValue;
  document.getElementById('swSavedRow').style.display = 'flex';
  updateSetupTitle(savedSwTimeValue);
}

// Default the date field to today
const dateField = document.getElementById('dateField');
function setDateToday(){
  const today = new Date();
  const yyyy = today.getFullYear();
