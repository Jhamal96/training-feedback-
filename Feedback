  const win = window.open('', '_blank');
  if (win) {
    win.document.write(reportHtml);
    win.document.close();
  } else {
    alert('Please allow popups in your browser to open the PDF in a new tab.');
  }
}

// ---- Native Save Evaluation to History ----
function saveDocument(){
  const traineeName = document.getElementById('traineeNameField').value.trim() || 'Unnamed Trainee';
  const missionVal = getMissionValue();
  const dateVal = dateField.value || 'no date';
  const ticketVal = document.getElementById('ticketField').value || '';
  const routesVal = document.getElementById('routesField').value || '';
  const total = document.getElementById('totalScore').textContent;
  const trainingType = document.getElementById('activeTrainingType').value;
  const now = new Date();
  const timeLabel = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

  // Gather full evaluation snapshot
  const categoryNotes = activeCategories.map((_, i) => {
    const el = document.getElementById(`catNotes-${i}`);
    return el ? el.value : '';
  });

  const snapshot = {
    id: currentEditingId ? currentEditingId : ++historyIdCounter,
    trainingType,
    traineeName,
    missionVal,
    rawMissionSelect: missionField.value,
    customMissionVal: customMissionField.value,
    dateVal,
    ticketVal,
    routesVal,
    total,
    timeLabel,
    savedSwTime: savedSwTimeValue,
    scores: [...scores],
    categoryNotes,
    quickCapture: {
      addNotes: document.getElementById('qcAddNotes').value,
      oddCallouts: document.getElementById('qcOddCallouts').value,
      disengagements: document.getElementById('qcDisengagements').value,
      dataCol: document.getElementById('qcDataCol').value
    },
    strengths: document.getElementById('strengthsField').value,
    improvements: document.getElementById('improvementsField').value
  };

  if (currentEditingId) {
    const idx = savedHistory.findIndex(e => e.id === currentEditingId);
    if (idx !== -1) {
      savedHistory[idx] = snapshot;
    } else {
      savedHistory.unshift(snapshot);
    }
  } else {
    savedHistory.unshift(snapshot);
  }

  saveHistoryToStorage();
  renderHistory();

  // Reset currentEditingId after saving
  currentEditingId = null;
  const saveBtn = document.getElementById('saveBtn');
  if (saveBtn) saveBtn.textContent = 'Save Evaluation';

  alert("Evaluation saved to history!\n\nYou can click 'Open PDF' next to the entry in Saved History whenever you're ready to print or view the PDF.");
}

function createNewForm(){
  if(!confirm('Start a new document or change training type? Any unsaved changes on this form will be lost.')) return;

  currentEditingId = null;
  const saveBtn = document.getElementById('saveBtn');
  if (saveBtn) saveBtn.textContent = 'Save Evaluation';

  document.querySelectorAll('#pdfRoot input[type=text], #pdfRoot textarea').forEach(el => el.value = '');
  missionField.selectedIndex = 0;
  customMissionField.style.display = 'none';
  customMissionField.value = '';
  setDateToday();
  swClear();

  // Return to landing view
  document.getElementById('mainFormWrap').style.display = 'none';
  document.getElementById('landingView').style.display = 'block';
  document.getElementById('initialTrainingSelect').selectedIndex = 0;
}

