async function copyForGoogleDocs() {
  const docsBtn = document.getElementById('docsBtn');
  docsBtn.disabled = true;
  docsBtn.textContent = 'Formatting...';

  try {
    const formattedHtml = buildGoogleDocsContent();
    
    // Create hidden rich-text container to trigger native DOM copy buffer
    const container = document.createElement('div');
    container.innerHTML = formattedHtml;
    container.style.position = 'fixed';
    container.style.left = '-9999px';
    container.style.top = '0';
    document.body.appendChild(container);

    // Try standard Clipboard API first with rich HTML payload
    let copied = false;
    if (navigator.clipboard && window.ClipboardItem) {
      try {
        const blobHtml = new Blob([formattedHtml], { type: 'text/html' });
        const blobText = new Blob([container.innerText], { type: 'text/plain' });
        await navigator.clipboard.write([
          new ClipboardItem({
            'text/html': blobHtml,
            'text/plain': blobText
          })
        ]);
        copied = true;
      } catch (e) {
        console.warn('Clipboard API error, falling back to selection copy:', e);
      }
    }

    // Fallback selection range copy
    if (!copied) {
      const range = document.createRange();
      range.selectNodeContents(container);
      const selection = window.getSelection();
      selection.removeAllRanges();
      selection.addRange(range);
      document.execCommand('copy');
      selection.removeAllRanges();
    }

    document.body.removeChild(container);
    alert("Formatted for Google Docs!\n\n1. Open your Google Doc\n2. Press Paste (Ctrl+V / Cmd+V) to insert formatted tables & scorecards.");
  } catch (err) {
    console.error('Failed to copy formatted text:', err);
    alert('Could not auto-copy formatted text. Please check browser permissions.');
  } finally {
    docsBtn.disabled = false;
    docsBtn.textContent = 'Copy for Google Docs';
  }
}

// ---- Persistent Session History ----
let savedHistory = [];
let historyIdCounter = 0;

function loadHistoryFromStorage(){
  try {
    const data = localStorage.getItem('zoox_grading_history');
    if (data) {
      savedHistory = JSON.parse(data);
      if (savedHistory.length > 0) {
        historyIdCounter = Math.max(...savedHistory.map(item => item.id || 0));
      }
    }
  } catch (e) {
    console.error('Failed to load history from storage:', e);
  }
  renderHistory();
}

function saveHistoryToStorage(){
  try {
    localStorage.setItem('zoox_grading_history', JSON.stringify(savedHistory));
  } catch (e) {
    console.error('Failed to save history to storage:', e);
  }
}

function renderHistory(){
  const list = document.getElementById('historyList');
  const empty = document.getElementById('historyEmpty');
  list.innerHTML = '';
  if (savedHistory.length === 0) {
    list.appendChild(empty);
    return;
  }
  savedHistory.forEach(entry => {
    const item = document.createElement('div');
    item.className = 'history-item';
    const evalCats = getCategoriesForType(entry.trainingType);
    const maxTotal = evalCats.length * maxPerCategory;
    item.innerHTML = `
      <div class="history-meta">
        <div class="h-title">${entry.traineeName} — ${entry.missionVal} (${entry.trainingType || 'SWO'})</div>
        <div class="h-sub">${entry.dateVal} · Score ${entry.total}/${maxTotal} · saved ${entry.timeLabel}</div>
      </div>
      <div class="history-actions">
        <button class="history-delete" onclick="deleteHistoryItem(${entry.id})">Delete</button>
        <button class="history-edit" onclick="editHistoryItem(${entry.id})">Edit</button>
        <button class="history-link" onclick="openPdfFromHistory(${entry.id})">Open PDF</button>
      </div>
    `;
    list.appendChild(item);
  });
}

function deleteHistoryItem(id){
  const entry = savedHistory.find(e => e.id === id);
  if (!entry) return;
  if (!confirm(`Delete the saved record for ${entry.traineeName} — ${entry.missionVal}?`)) return;
  savedHistory = savedHistory.filter(e => e.id !== id);
  saveHistoryToStorage();
  renderHistory();
  if (currentEditingId === id) {
    currentEditingId = null;
    const saveBtn = document.getElementById('saveBtn');
    if (saveBtn) saveBtn.textContent = 'Save Evaluation';
  }
}

function loadSnapshotIntoForm(snapshot) {
  if (!snapshot) return;

  // Set training type
  const tType = snapshot.trainingType || 'SWO';
  document.getElementById('activeTrainingType').value = tType;
  onTrainingTypeChange();

  // Basic info
  document.getElementById('traineeNameField').value = snapshot.traineeName || '';
  document.getElementById('dateField').value = snapshot.dateVal || '';
  document.getElementById('ticketField').value = snapshot.ticketVal || '';
  document.getElementById('routesField').value = snapshot.routesVal || '';

  // Stopwatch state restore
  if (snapshot.savedSwTime) {
    savedSwTimeValue = snapshot.savedSwTime;
    document.getElementById('swSavedTime').textContent = savedSwTimeValue;
    document.getElementById('swSavedRow').style.display = 'flex';
    updateSetupTitle(savedSwTimeValue);
  } else {
    savedSwTimeValue = "";
    document.getElementById('swSavedRow').style.display = 'none';
    document.getElementById('swSavedTime').textContent = "00:00:00";
    updateSetupTitle("");
  }

  // Mission dropdown & custom input restore
  if (snapshot.rawMissionSelect === 'Other' || snapshot.customMissionVal) {
    missionField.value = 'Other';
    customMissionField.style.display = 'block';
    customMissionField.value = snapshot.customMissionVal || snapshot.missionVal || '';
  } else if (snapshot.missionVal) {
    let found = false;
    for (let i = 0; i < missionField.options.length; i++) {
      if (missionField.options[i].textContent === snapshot.missionVal || missionField.options[i].value === snapshot.missionVal) {
        missionField.selectedIndex = i;
        found = true;
        break;
      }
    }
    if (!found) {
      missionField.value = 'Other';
      customMissionField.style.display = 'block';
      customMissionField.value = snapshot.missionVal;
    } else {
      customMissionField.style.display = 'none';
      customMissionField.value = '';
    }
  } else {
    missionField.selectedIndex = 0;
    customMissionField.style.display = 'none';
    customMissionField.value = '';
  }

  // Scores
  if (Array.isArray(snapshot.scores)) {
    snapshot.scores.forEach((s, idx) => {
      scores[idx] = s;
      const scoreRow = document.getElementById(`scores-${idx}`);
      if (scoreRow) {
        scoreRow.querySelectorAll('.score-btn').forEach(b => b.classList.remove('selected'));
        if (s !== null && s !== undefined) {
          const targetBtn = Array.from(scoreRow.querySelectorAll('.score-btn')).find(b => b.textContent == s);
          if (targetBtn) targetBtn.classList.add('selected');
        }
      }
      const catCard = document.querySelectorAll('.cat')[idx];
      if (catCard) {
        const tallySpan = catCard.querySelector(`#tally-${idx} span`);
        if (tallySpan) tallySpan.textContent = s !== null ? s : 0;
      }
    });
    updateTotal();
  }

  // Category Notes
  if (Array.isArray(snapshot.categoryNotes)) {
    snapshot.categoryNotes.forEach((note, idx) => {
      const el = document.getElementById(`catNotes-${idx}`);
      if (el) el.value = note || '';
    });
  }

  // Quick Capture & Feedback
  if (snapshot.quickCapture) {
    document.getElementById('qcAddNotes').value = snapshot.quickCapture.addNotes || '';
    document.getElementById('qcOddCallouts').value = snapshot.quickCapture.oddCallouts || '';
    document.getElementById('qcDisengagements').value = snapshot.quickCapture.disengagements || '';
    document.getElementById('qcDataCol').value = snapshot.quickCapture.dataCol || '';
  } else {
    document.getElementById('qcAddNotes').value = '';
    document.getElementById('qcOddCallouts').value = '';
    document.getElementById('qcDisengagements').value = '';
    document.getElementById('qcDataCol').value = '';
  }
  document.getElementById('strengthsField').value = snapshot.strengths || '';
  document.getElementById('improvementsField').value = snapshot.improvements || '';
}

